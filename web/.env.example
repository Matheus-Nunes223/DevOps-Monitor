# Copie para .env.local; use somente a chave publishable ou anon do Supabase.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY ou chaves sb_secret_* neste arquivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos Supabase que ainda usam a chave JWT anon:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

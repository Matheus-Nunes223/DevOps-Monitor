compatibility_level = 3.6
myhostname = postfix.lab.local
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8, 172.28.0.0/16
relayhost = [mailhog]:1025
smtp_tls_security_level = none
maillog_file = /dev/stdout
smtpd_banner = $myhostname ESMTP Postfix $mail_version

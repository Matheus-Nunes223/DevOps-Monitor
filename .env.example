# Coletor (somente ambiente local; nunca commitar valores reais)
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres do laboratório monitorado; preencher conforme credenciais do compose.
# Padrão do compose já aponta para o Postgres do laboratório; só preencha para sobrescrever.
LAB_DB_URL=
COLLECT_INTERVAL_SECONDS=15
ALERT_SMTP_HOST=mailhog
ALERT_SMTP_PORT=1025
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alertas@devops.local
DASHBOARD_URL=http://localhost:3000
NVD_API_KEY=

# Painel web (use a publishable key; a anon key legada também é aceita).
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY em NEXT_PUBLIC_* ou em web/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
